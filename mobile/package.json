{
  "name": "cu-lao-gieng-app",
  "version": "1.0.0",
  "private": true,
  "description": "Android app Cù Lao Giêng: the website UI packaged with Capacitor",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "icons": "capacitor-assets generate --android --iconBackgroundColor \"#0369a1\" --splashBackgroundColor \"#d3ecfb\"",
    "sync": "npm run copy-web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
