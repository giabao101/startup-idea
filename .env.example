# Copy to .env and fill in. Without a key, the AI guide runs in offline (keyword) mode.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google Maps JavaScript API key (restrict by HTTP referrer). Optional Map ID for vector/3D.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
# PostgreSQL (free: neon.tech or supabase.com). Empty = local SQLite file data/app.db
DATABASE_URL=
# Random string, at least 32 characters (keeps users signed in across restarts)
SESSION_SECRET=
# Admin account, created/updated on start. Password at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Google Sheets sync (see docs/google-sheets.gs)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
GOOGLE_SHEET_URL=
PORT=3000
